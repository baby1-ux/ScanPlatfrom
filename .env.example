# ---------------- 后端 apps/server ----------------
PORT=3000

# 数据库：sqlite（默认，零依赖，直接可用）/ mysql（适配层已预留，见 apps/server/src/db/index.ts）
DB_CLIENT=sqlite
SQLITE_PATH=../../data/vuln_platform.db

# MySQL 配置（DB_CLIENT=mysql 时生效）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=vuln_platform

# JWT 密钥：生产环境必须改成随机长串，否则启动直接报错
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=8h

# 首次启动自动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# 启动时若库为空则灌入演示数据（含 8 个项目 / 100+ 批次 / 7000+ 样本）
SEED_DEMO_DATA=true
# 演示数据放大倍数（1 = 默认规模）
SEED_SCALE=1

# 允许跨域的前端地址，逗号分隔
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=info

# ---------------- ScanMan 模型推理服务 ----------------
ML_SERVICE_URL=http://127.0.0.1:8000
# fallback=模型不可用时降级为启发式判定 / strict=直接返回 503
ML_FALLBACK=fallback
ML_TIMEOUT_MS=8000

# ---------------- 前端 apps/web ----------------
VITE_API_BASE=/api/v1
# 开发期 vite 代理目标
VITE_PROXY_TARGET=http://127.0.0.1:3000
