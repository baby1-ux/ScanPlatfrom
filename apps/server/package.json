{
  "name": "@vuln/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings=ExperimentalWarning --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:reset": "tsx --env-file-if-exists=../../.env src/scripts/reset-db.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed-only.ts",
    "test": "node --no-warnings=ExperimentalWarning --import tsx/esm --test tests/integration.test.ts"
  },
  "dependencies": {
    "@vuln/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/pino-http": "^5.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
